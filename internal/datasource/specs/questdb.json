        "descriptionKey": "datasource.variant.questdb.v7",
        "maxServer": "8.0"
      },
      {
        "id": "v8",
        "label": "QuestDB 8.x – 9.x",
        "descriptionKey": "datasource.variant.questdb.v8",
        "minServer": "8.0",
        "maxServer": "10.0"
      },
      {
        "id": "v10",
        "label": "QuestDB 10.x +",
        "descriptionKey": "datasource.variant.questdb.v10",
        "minServer": "10.0"
      }
    ]
  },
  "ui": {
    "defaultUser": "admin",
    "formatDdl": false,
    "uriSchemes": [
      "questdb",
      "postgresql",
